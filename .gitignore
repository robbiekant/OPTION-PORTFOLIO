# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Generated artefacts — regenerated by `python -m thetaforge.cli run`
output/*.html
data/snapshots/*/portfolio.json

# Market data snapshots are KEPT in git on purpose: underlyings.json and
# meta.json are the inputs that make every past build reproducible offline.
# The bulky raw chains and the derived portfolio are not.
data/snapshots/*/chains/

# Secrets — never commit these
.env
*.pem
*.key
config.local.py
ibkr_credentials*

# OS noise
.DS_Store
Thumbs.db
